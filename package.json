{
  "name": "opentrailscience",
  "version": "1.0.0",
  "private": true,
  "description": "Open Trail Science: crowdsourced thru-hiker survey and open research dataset",
  "license": "MIT",
  "author": "Open Trail Science",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "npm run build:css && (npm run export-data || echo 'Could not refresh public/data from the database; showing the last export.') && node scripts/dev-server.js",
    "dev:offline": "npm run build:css && node scripts/dev-server.js --offline",
    "start": "netlify dev",
    "build": "npm run build:css && npm run build:js && npm run export-data",
    "build:css": "tailwindcss -i src/tailwind.css -o public/css/tailwind.css --minify",
    "build:js": "node scripts/build-js.js",
    "export-data": "node scripts/export-static-dataset.js",
    "docs": "node scripts/generate-data-dictionary.js",
    "test": "node --test",
    "seed": "node scripts/seed-db.js",
    "db:remove-synthetic": "node scripts/remove-synthetic.js",
    "db:check": "node scripts/check-db.js",
    "db:setup": "node scripts/setup-db.js",
    "render:example-card": "node scripts/render-example-card.js",
    "feedback": "node scripts/read-feedback.js"
  },
  "keywords": [
    "thru-hiking",
    "pct",
    "appalachian-trail",
    "continental-divide-trail",
    "survey",
    "machine-learning",
    "dataset"
  ],
  "dependencies": {
    "mongodb": "^7.7.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "dotenv": "^16.6.1",
    "esbuild": "0.28.2",
    "tailwindcss": "4.3.3"
  }
}
